# ==============================================================================
# Napsed Environment Configuration
# ==============================================================================
# 
# 1. DEFAULT OPEN-SOURCE MODE (MOCK MODE):
#    Leave everything empty or keep VITE_MOCK_MODE=true.
#    You do NOT need Supabase, Judge0, or GitHub OAuth credentials.
#    Specs load from disk (`specs/`), and code runs in-browser via Web Workers.
# ==============================================================================

VITE_MOCK_MODE=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ==============================================================================
# 2. LOCAL BACKEND / DATABASE SCHEMA CONTRIBUTORS (OPTIONAL):
#    Only needed if you are modifying SQL migrations or Prisma schemas locally.
#    Run `npx supabase start` to spin up a local Dockerized Supabase stack.
#    Local Supabase default ports:
#      - API URL: http://127.0.0.1:54321
#      - Postgres DB: postgresql://postgres:postgres@localhost:54322/postgres
# ==============================================================================

# VITE_MOCK_MODE=false
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<anon_key_from_supabase_start>
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ==============================================================================
# 3. PRODUCTION CLOUD ONLY (MAINTAINER ONLY):
#    NEVER expose Judge0 keys or service role secrets in client (no VITE_JUDGE0_*).
# ==============================================================================
# JUDGE0_API_KEY=
